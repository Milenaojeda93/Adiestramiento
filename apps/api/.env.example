NODE_ENV=development
PORT=4000
# Rol dueño de las tablas (migraciones, login, alta de empresas, panel SaaS)
DATABASE_URL_OWNER=postgresql://adiestra_owner:owner_dev@localhost:5432/adiestra
# Rol de la aplicación, sujeto a Row Level Security
DATABASE_URL_APP=postgresql://adiestra_app:app_dev@localhost:5432/adiestra
WEB_ORIGIN=http://localhost:3000
SESSION_DAYS=7
GRACE_DAYS=5
